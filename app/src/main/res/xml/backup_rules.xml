<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and below (API 24-30). Ignored on Android 12+, which uses
    data_extraction_rules.xml.

    All app data is a re-downloadable cache of public GitHub data (the SQLDelight database), so it is
    intentionally excluded from backup. Restoring it would waste the user's backup quota and could bring
    back stale or schema-incompatible cache data.

    Keep in sync with data_extraction_rules.xml. When a user preference store is added, replace these
    domain-wide excludes with an <include> for only that file, in both files: excludes take precedence
    over includes, so an <include> next to them backs up nothing.
    See https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
