<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <!-- Trust user-added CAs so a local HTTPS proxy (Charles, Proxyman, mitmproxy)
                 can inspect traffic. Debug build type only.
                 debug-overrides adds these on top of the default system CAs. -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
